          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/modelos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "modelos"
              ]
            },
            "description": "Mira la consola de IntelliJ: aparece el SQL con 'join marcas'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Cada modelo trae el nombre de su marca', () => {",
                  "    pm.response.json().forEach(m => pm.expect(m.marcaNombre).to.be.a('string'));",
                  "});"
